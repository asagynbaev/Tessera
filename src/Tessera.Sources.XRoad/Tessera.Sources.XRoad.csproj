<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tessera.Sources.XRoad</RootNamespace>
    <AssemblyName>Tessera.Sources.XRoad</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>Layer-2 plugin: maps government-registry lookups over X-Road to Tessera AttestationDrafts (jurisdiction/residency, property_right, encumbrance). Implements IAttestationSource; depends only on the core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tessera.Attestations\Tessera.Attestations.csproj" />
    <ProjectReference Include="..\Tessera.Core\Tessera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tessera.Sources.XRoad.Tests" />
  </ItemGroup>

</Project>
