<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tessera.Examples.CardanoCreditLine</RootNamespace>
    <Description>Console sample: issue an income attestation with a Pedersen commitment, anchor the Merkle root on Cardano preprod (Validator mode), prove income ≥ 50,000 with a Bulletproof, and verify the presentation against the on-chain root + revocation epoch.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tessera.Sdk\Tessera.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Tessera.Signing\Tessera.Signing.csproj" />
    <ProjectReference Include="..\..\src\Tessera.Attestations\Tessera.Attestations.csproj" />
    <ProjectReference Include="..\..\src\Tessera.Did\Tessera.Did.csproj" />
    <ProjectReference Include="..\..\src\Tessera.Core\Tessera.Core.csproj" />
    <ProjectReference Include="..\..\src\Tessera.Chains.Abstractions\Tessera.Chains.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Tessera.Chains.Cardano\Tessera.Chains.Cardano.csproj" />
  </ItemGroup>

</Project>
