<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pure meta-package: ships ONLY the sub-package dependencies below, no compiled source. The
         legacy Tessera.Crypto / Tessera.Security duplicate of Tessera.Cryptography (a second,
         variable-time secp256k1/Bulletproofs stack) has been removed; this guard keeps it gone. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- "Tessera" / "Tessera.*" IDs are owned by other authors on nuget.org; publish under the
         owner-scoped, reservable "Sagynbaev." prefix. AssemblyName stays "Tessera". Version is
         supplied by the publish workflow (-p:Version / -p:PackageVersion from the git tag). -->
    <PackageId>Sagynbaev.Tessera</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/asagynbaev/Tessera</PackageProjectUrl>
    <RepositoryUrl>https://github.com/asagynbaev/Tessera</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Azimbek Sagynbaev</Authors>
    <Description>Privacy-preserving identity and reputation infrastructure for .NET. DIDs, attestations, selective disclosure via Merkle bundles, and Bulletproof predicate proofs over committed values. Meta-package — references Tessera.Core, Tessera.Did, Tessera.Attestations, Tessera.Cryptography, Tessera.Chains.Abstractions.</Description>
    <PackageTags>did;decentralized-identity;verifiable-credentials;attestations;selective-disclosure;identity;reputation;privacy;bulletproofs;zero-knowledge-proof;pedersen-commitment;range-proof;secp256k1;solana;stellar;dotnet</PackageTags>
    <PackageReleaseNotes>v4.0.0 — security-hardening release (no Critical findings across a multi-round audit). Tessera.Cryptography is now CONSTANT-TIME (limb-based secp256k1 + branchless scalar multiplication, cross-checked against an independent BouncyCastle oracle) and rejects non-canonical point/scalar encodings. Adds controller-authenticated wallet binding (BOLA fix), issuer trust-root protection, and attestation expiry caps. (breaking) Removed the legacy Tessera.Crypto / Tessera.Security duplicate crypto stack this meta-package shipped alongside Tessera.Cryptography — use Tessera.Cryptography (Pedersen / Bulletproofs / secp256k1) directly. See CHANGELOG.md and docs/security-audit-readiness.md.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    v3 meta-package: pull in sub-packages so consumers can add a single
    <PackageReference Include="Tessera" Version="3.*" /> and get everything.
    Chain adapters are opt-in (separate packages, not included here).
  -->
  <ItemGroup>
    <ProjectReference Include="..\src\Tessera.Core\Tessera.Core.csproj" />
    <ProjectReference Include="..\src\Tessera.Did\Tessera.Did.csproj" />
    <ProjectReference Include="..\src\Tessera.Attestations\Tessera.Attestations.csproj" />
    <ProjectReference Include="..\src\Tessera.Cryptography\Tessera.Cryptography.csproj" />
    <ProjectReference Include="..\src\Tessera.Chains.Abstractions\Tessera.Chains.Abstractions.csproj" />
  </ItemGroup>

</Project>
